# Copy to .env.local and fill in. See README and docs/architecture.md.

# ── Database (two roles on the SAME database) ──
# Owner role — used only by drizzle-kit generate/migrate (DDL). Never by the app.
DATABASE_URL=
# Least-privilege app role (NOSUPERUSER NOBYPASSRLS) — what the running app uses.
APP_DATABASE_URL=

# Public URL of this deployment, used in invite, statement and M-Pesa links.
PORTAL_BASE_URL=https://your-domain.example

# Vercel Cron authorisation (Vercel sends it automatically when set).
CRON_SECRET=

# ── Platform payments (IntaSend) — the group paying the platform ──
INTASEND_SECRET_KEY=
INTASEND_ENV=sandbox
INTASEND_WEBHOOK_CHALLENGE=
# Optional, sent as INTASEND_PUBLIC_API_KEY on wallet calls
INTASEND_PUBLISHABLE_KEY=
# Group wallets (platform holds a wallet per group). Keep false until
# IntaSend has approved the use and a lawyer has confirmed the custody model.
GROUP_WALLETS_ENABLED=false

# Partner API (funeral funds): "<partner>:<token>" pairs, comma-separated,
# tokens at least 24 characters. Family Compass uses partner "familycompass".
PARTNER_API_TOKENS=
# Bereavement referrals to Family Compass (both needed to switch on)
FAMILY_COMPASS_REFERRAL_URL=
FAMILY_COMPASS_REFERRAL_SECRET=

# File uploads (KYC documents, group papers)
BLOB_READ_WRITE_TOKEN=
# Optional second Blob store, created with PRIVATE access: KYC documents (ID
# scans, photos, signatures) go there and are served only through
# /api/files after checking who asks. Move older files with
# `npm run files:move-kyc-private`.
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Signs members' no-password statement links (any long random string).
STATEMENT_LINK_SECRET=

# ── SMS (optional) — Africa's Talking; without these, SMS is skipped and links are shown instead ──
AT_USERNAME=
AT_API_KEY=
# Approved alphanumeric sender id (optional)
AT_SENDER_ID=
# "sandbox" to use the sandbox endpoint
AT_ENV=

# ── Agent trigger from another system (optional) — POST /api/internal/agent ──
# The agent is fixed rules (no AI); it also runs daily by cron without this.
AGENT_API_TOKEN=

# ── Optional sign-in / notifications ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOVU_API_KEY=
NOVU_WORKFLOW_ID=
NOVU_API_URL=

# ── Local development only: plain Postgres through a websocket proxy (never in production) ──
# NEON_LOCAL_WS_PROXY=localhost:54330

# ── Seed script (npm run db:seed) ──
# ADMIN_EMAIL=admin@chama.local
# ADMIN_PASSWORD=Admin1234!
# ADMIN_NAME=Admin
# GROUP_NAME=My Chama
# GROUP_TYPE=chama
